# AgariyaCare AI — Root Environment Configuration
# This file documents all environment variables required by the backend.
# Copy backend/.env.example → backend/.env and fill in your values.
# Never commit real credentials to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Required for production. Without DATABASE_URL, healthcare/safety data uses
# in-memory repositories (acceptable for development only).
DATABASE_URL=postgresql://postgres:password@localhost:5432/agariyacare

# ── Authentication ────────────────────────────────────────────────────────────
# Use a random 32+ character string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# Cookie signing secret (for HttpOnly auth cookies)
COOKIE_SECRET=your-cookie-secret-change-in-production

# ── Frontend URL (CORS) ───────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── IBM Granite AI (IBM watsonx) ──────────────────────────────────────────────
# Required for production IBM Granite AI responses.
# Without these, the system uses the Development AI provider (context-aware
# fallback that clearly identifies itself as development mode).
#
# 1. Sign in to https://cloud.ibm.com
# 2. Create a watsonx.ai project
# 3. Generate an API key: https://cloud.ibm.com/iam/apikeys
# 4. Find your Project ID: watsonx.ai → Manage → General
#
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL=ibm/granite-13b-chat-v2
# Alternative models:
#   ibm/granite-3-8b-instruct
#   ibm/granite-3-2b-instruct

# ── Optional Integrations ─────────────────────────────────────────────────────
# Weather API (for safety monitoring — optional)
WEATHER_API_KEY=

# Emergency contact number (displayed in SOS responses — default: 108)
EMERGENCY_CONTACT_PHONE=108
