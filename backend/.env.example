PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/agariyacare

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your-cookie-secret-change-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# ── Phase 4: IBM Granite AI (IBM watsonx) ──────────────────────────────────────
# Required for production IBM Granite AI responses.
# Without these, the backend uses the Development AI provider (fallback mode).
#
# 1. Sign in to https://cloud.ibm.com and create a watsonx.ai project
# 2. Generate an API key at https://cloud.ibm.com/iam/apikeys
# 3. Find your Project ID in watsonx.ai → Manage → General
#
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL=ibm/granite-13b-chat-v2
# Alternative models:
#   ibm/granite-3-8b-instruct
#   ibm/granite-3-2b-instruct
