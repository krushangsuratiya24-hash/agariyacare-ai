{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/index.ts",
    "src/db/**/*",
    "src/middleware/auth.ts",
    "src/middleware/errorHandler.ts",
    "src/middleware/upload.ts",
    "src/middleware/auth.middleware.ts",
    "src/routes/auth.ts",
    "src/routes/users.ts",
    "src/routes/admin.ts",
    "src/routes/marketplace.ts",
    "src/routes/offers.ts",
    "src/routes/ai.routes.ts",
    "src/controllers/**/*",
    "src/utils/**/*",
    "src/types/**/*",
    "src/agents/**/*",
    "src/providers/**/*",
    "src/repositories/**/*",
    "src/data/**/*",
    "src/config/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/routes/auth.routes.ts",
    "src/routes/community.routes.ts",
    "src/routes/healthcare.routes.ts",
    "src/routes/market.routes.ts",
    "src/routes/marketplace.routes.ts",
    "src/routes/notifications.routes.ts",
    "src/routes/offers.routes.ts",
    "src/routes/safety.routes.ts",
    "src/routes/welfare.routes.ts",
    "src/routes/workers.routes.ts",
    "src/routes/analytics.routes.ts",
    "src/middleware/error.middleware.ts"
  ]
}
